---
import Base from '../layouts/Base.astro';
import ItemList from '../components/ItemList.astro';
import Filter from '../components/Filter.astro';
import { fmtDate, type Item } from '../lib/site';
import news from '../data/news.json';

const items = news.items as Item[];
const counts: Record<string, number> = {};
for (const it of items) for (const c of it.categories) counts[c] = (counts[c] ?? 0) + 1;
---
<Base title="입시 뉴스" description="수시·정시·수능·의대·고입 등 입시 관련 최신 뉴스를 자동으로 모았습니다.">
  <h1>입시 뉴스</h1>
  <p class="muted">
    최근 45일 동안 모은 입시 기사 {items.length}건 · {fmtDate(news.updatedAt, true)} 갱신
  </p>
  <Filter counts={counts} />
  <ItemList items={items} showSummary />
</Base>
