---
import Base from '../layouts/Base.astro';
import { u } from '../lib/site';
---
<Base title="검색">
  <h1>검색</h1>
  <link href={u('/pagefind/pagefind-ui.css')} rel="stylesheet" />
  <div id="search"></div>
  <p class="muted small">검색 색인은 배포할 때 만들어집니다. 개발 서버(npm run dev)에서는 동작하지 않습니다.</p>
  <script is:inline define:vars={{ bundle: u('/pagefind/') }}>
    const s = document.createElement('script');
    s.src = bundle + 'pagefind-ui.js';
    s.onload = () => new PagefindUI({ element: '#search', showSubResults: true, translations: { placeholder: '학교, 전형, 키워드 검색' } });
    document.head.appendChild(s);
  </script>
</Base>
