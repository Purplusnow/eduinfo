---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Ad from '../../components/Ad.astro';
import { fmtDate, u } from '../../lib/site';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(guides.map((g) => g.data.category))];
const digests = (await getCollection('digests')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="입시 가이드" description="수시·정시·수능·전형 용어를 처음부터 이해할 수 있게 정리한 입시 가이드">
  <h1>입시 가이드</h1>
  <p class="muted">입시 제도를 처음 접하는 학생·학부모를 위한 정리글입니다. 각 글 아래에 근거 자료를 달았습니다.</p>
  <Ad pos="top" />
  {groups.map((cat) => (
    <section>
      <h2>{cat}</h2>
      <div class="grid">
        {guides.filter((g) => g.data.category === cat).map((g) => (
          <a class="card" href={u(`/guides/${g.id}/`)} style="color:inherit;text-decoration:none">
            <h3>{g.data.title}</h3>
            <p class="summary">{g.data.description}</p>
            <p class="meta">{fmtDate(g.data.updated.toISOString())} 업데이트</p>
          </a>
        ))}
      </div>
    </section>
  ))}
  {digests.length > 0 && (
    <section>
      <h2>주간 입시 브리핑</h2>
      <ul class="items">
        {digests.map((d) => (
          <li>
            <a class="title" href={u(`/digest/${d.id}/`)}>{d.data.title}</a>
            <p class="summary">{d.data.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
