---
import Base from '../layouts/Base.astro';
import groups from '../data/links.json';
---
<Base title="기관·사이트 모음" description="대입·수능·진로·장학 관련 공식 기관과 사이트 모음">
  <h1>기관·사이트 모음</h1>
  <p class="muted">입시 준비에 필요한 공식 사이트를 분야별로 정리했습니다.</p>
  <div class="grid">
    {groups.map((g) => (
      <section class="card">
        <h2>{g.group}</h2>
        <ul class="items">
          {g.links.map((l) => (
            <li>
              <a class="title" href={l.url} target="_blank" rel="noopener">{l.name}</a>
              {l.desc && <p class="summary">{l.desc}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
